    },
    {
      "n": 4,
      "id": "STM-004-FIL-001-model.py",
      "text": "1) the official GPT-2 TensorFlow implementation released by OpenAI:",
      "firstCommit": 1,
      "kind": "docstring"
    },
    {
      "n": 5,
      "id": "STM-005-FIL-001-model.py",
