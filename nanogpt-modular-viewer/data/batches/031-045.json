    },
    {
      "n": 241,
      "id": "STM-241-FIL-001-model.py",
      "text": "        # copy while ensuring all of the parameters are aligned and match in names and shapes",
      "firstCommit": 42,
      "kind": "comment"
    },
    {
      "n": 242,
      "id": "STM-242-FIL-001-model.py",
      "text": "        sd_keys_hf = sd_hf.keys()",
      "firstCommit": 42,
      "kind": "code"
    },
    {
      "n": 243,
      "id": "STM-243-FIL-001-model.py",
      "text": "        sd_keys_hf = [k for k in sd_keys_hf if not k.endswith('.attn.masked_bias')] # ignore these, just a buffer",
      "firstCommit": 42,
      "kind": "code"
    },
    {
      "n": 244,
      "id": "STM-244-FIL-001-model.py",
      "text": "        sd_keys_hf = [k for k in sd_keys_hf if not k.endswith('.attn.bias')] # same, just the mask (buffer)",
      "firstCommit": 42,
      "kind": "code"
    },
    {
      "n": 245,
      "id": "STM-245-FIL-001-model.py",
      "text": "        transposed = ['attn.c_attn.weight', 'attn.c_proj.weight', 'mlp.c_fc.weight', 'mlp.c_proj.weight']",
      "firstCommit": 42,
      "kind": "code"
    },
    {
      "n": 246,
      "id": "STM-246-FIL-001-model.py",
      "text": "        # basically the openai checkpoints use a \"Conv1D\" module, but we only want to use a vanilla Linear",
      "firstCommit": 42,
