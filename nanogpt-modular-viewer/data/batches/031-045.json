    },
    {
      "n": 226,
      "id": "STM-226-FIL-001-model.py",
      "text": "        # we can override the dropout rate, if desired",
      "firstCommit": 39,
      "kind": "comment"
    },
    {
      "n": 227,
      "id": "STM-227-FIL-001-model.py",
      "text": "        if 'dropout' in override_args:",
      "firstCommit": 39,
      "kind": "code"
    },
    {
      "n": 228,
      "id": "STM-228-FIL-001-model.py",
      "text": "            print(f\"overriding dropout rate to {override_args['dropout']}\")",
      "firstCommit": 39,
