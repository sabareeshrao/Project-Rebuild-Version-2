    },
    {
      "n": 229,
      "id": "STM-229-FIL-001-model.py",
      "text": "            config_args['dropout'] = override_args['dropout']",
      "firstCommit": 39,
      "kind": "code"
    },
    {
      "n": 230,
      "id": "STM-230-FIL-001-model.py",
      "text": "        # create a from-scratch initialized minGPT model",
      "firstCommit": 40,
      "kind": "comment"
    },
    {
      "n": 231,
      "id": "STM-231-FIL-001-model.py",
      "text": "        config = GPTConfig(**config_args)",
      "firstCommit": 40,
      "kind": "code"
    },
    {
      "n": 232,
      "id": "STM-232-FIL-001-model.py",
      "text": "        model = GPT(config)",
      "firstCommit": 40,
      "kind": "code"
    },
    {
      "n": 233,
      "id": "STM-233-FIL-001-model.py",
      "text": "        sd = model.state_dict()",
      "firstCommit": 40,
      "kind": "code"
    },
    {
      "n": 234,
      "id": "STM-234-FIL-001-model.py",
      "text": "        sd_keys = sd.keys()",
      "firstCommit": 40,
      "kind": "code"
    },
    {
      "n": 235,
      "id": "STM-235-FIL-001-model.py",
      "text": "        sd_keys = [k for k in sd_keys if not k.endswith('.attn.bias')] # discard this mask / buffer, not a param",
      "firstCommit": 40,
      "kind": "code"
    },
    {
      "n": 236,
      "id": "STM-236-FIL-001-model.py",
      "text": "",
      "firstCommit": 41,
      "kind": "blank"
    },
    {
      "n": 237,
      "id": "STM-237-FIL-001-model.py",
      "text": "        # init a huggingface/transformers model",
      "firstCommit": 41,
      "kind": "comment"
    },
    {
      "n": 238,
      "id": "STM-238-FIL-001-model.py",
      "text": "        model_hf = GPT2LMHeadModel.from_pretrained(model_type)",
      "firstCommit": 41,
      "kind": "code"
    },
    {
      "n": 239,
      "id": "STM-239-FIL-001-model.py",
      "text": "        sd_hf = model_hf.state_dict()",
      "firstCommit": 41,
