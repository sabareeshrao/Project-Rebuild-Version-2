    {
      "n": 170,
      "id": "STM-170-FIL-001-model.py",
      "text": "    def forward(self, idx, targets=None):",
      "firstCommit": 31,
      "kind": "code"
    },
    {
      "n": 171,
      "id": "STM-171-FIL-001-model.py",
      "text": "        device = idx.device",
      "firstCommit": 31,
      "kind": "code"
    },
    {
      "n": 172,
      "id": "STM-172-FIL-001-model.py",
      "text": "        b, t = idx.size()",
      "firstCommit": 31,
      "kind": "code"
    },
    {
      "n": 173,
      "id": "STM-173-FIL-001-model.py",
      "text": "        assert t <= self.config.block_size, f\"Cannot forward sequence of length {t}, block size is only {self.config.block_size}\"",
      "firstCommit": 31,
      "kind": "code"
    },
    {
      "n": 174,
      "id": "STM-174-FIL-001-model.py",
      "text": "        pos = torch.arange(0, t, dtype=torch.long, device=device) # shape (t)",
      "firstCommit": 31,
      "kind": "code"
    },
    {
      "n": 175,
      "id": "STM-175-FIL-001-model.py",
      "text": "",
      "firstCommit": 32,
      "kind": "blank"
    },
    {
      "n": 176,
      "id": "STM-176-FIL-001-model.py",
      "text": "        # forward the GPT model itself",
      "firstCommit": 32,
      "kind": "comment"
    },
    {
      "n": 177,
      "id": "STM-177-FIL-001-model.py",
      "text": "        tok_emb = self.transformer.wte(idx) # token embeddings of shape (b, t, n_embd)",
      "firstCommit": 32,
      "kind": "code"
    },
    {
      "n": 178,
      "id": "STM-178-FIL-001-model.py",
      "text": "        pos_emb = self.transformer.wpe(pos) # position embeddings of shape (t, n_embd)",
      "firstCommit": 32,
      "kind": "code"
    },
    {
      "n": 179,
      "id": "STM-179-FIL-001-model.py",
      "text": "        x = self.transformer.drop(tok_emb + pos_emb)",
      "firstCommit": 32,
      "kind": "code"
    },
    {
      "n": 180,
      "id": "STM-180-FIL-001-model.py",
      "text": "        for block in self.transformer.h:",
      "firstCommit": 32,
      "kind": "code"
    },
    {
      "n": 181,
      "id": "STM-181-FIL-001-model.py",
      "text": "            x = block(x)",
      "firstCommit": 32,
      "kind": "code"
    },
    {
      "n": 182,
      "id": "STM-182-FIL-001-model.py",
      "text": "        x = self.transformer.ln_f(x)",
      "firstCommit": 32,
      "kind": "code"
    },
    {
      "n": 183,
      "id": "STM-183-FIL-001-model.py",
      "text": "",
      "firstCommit": 33,
      "kind": "blank"
    },
    {
      "n": 184,
      "id": "STM-184-FIL-001-model.py",
      "text": "        if targets is not None:",
      "firstCommit": 33,
      "kind": "code"
    },
    {
      "n": 185,
      "id": "STM-185-FIL-001-model.py",
      "text": "            # if we are given some desired targets also calculate the loss",
      "firstCommit": 33,
      "kind": "comment"
    },
    {
      "n": 186,
      "id": "STM-186-FIL-001-model.py",
      "text": "            logits = self.lm_head(x)",
      "firstCommit": 33,
      "kind": "code"
    },
    {
      "n": 187,
      "id": "STM-187-FIL-001-model.py",
      "text": "            loss = F.cross_entropy(logits.view(-1, logits.size(-1)), targets.view(-1), ignore_index=-1)",
      "firstCommit": 33,
      "kind": "code"
    },
    {
      "n": 188,
      "id": "STM-188-FIL-001-model.py",
      "text": "        else:",
      "firstCommit": 34,
      "kind": "code"
    },
    {
      "n": 189,
      "id": "STM-189-FIL-001-model.py",
      "text": "            # inference-time mini-optimization: only forward the lm_head on the very last position",
      "firstCommit": 34,
      "kind": "comment"
    },
    {
      "n": 190,
      "id": "STM-190-FIL-001-model.py",
      "text": "            logits = self.lm_head(x[:, [-1], :]) # note: using list [-1] to preserve the time dim",
      "firstCommit": 34,
      "kind": "code"
    },
    {
      "n": 191,
      "id": "STM-191-FIL-001-model.py",
      "text": "            loss = None",
      "firstCommit": 34,
      "kind": "code"
    },
    {
      "n": 192,
      "id": "STM-192-FIL-001-model.py",
      "text": "",
      "firstCommit": 34,
      "kind": "blank"
    },
    {
      "n": 193,
      "id": "STM-193-FIL-001-model.py",
      "text": "        return logits, loss",
      "firstCommit": 34,
      "kind": "code"
    },
    {
      "n": 194,
      "id": "STM-194-FIL-001-model.py",
      "text": "",
      "firstCommit": 35,
      "kind": "blank"
    },
    {
      "n": 195,
      "id": "STM-195-FIL-001-model.py",
      "text": "    def crop_block_size(self, block_size):",
      "firstCommit": 35,
      "kind": "code"
    },
    {
      "n": 196,
      "id": "STM-196-FIL-001-model.py",
      "text": "        # model surgery to decrease the block size if necessary",
      "firstCommit": 35,
      "kind": "comment"
    },
    {
      "n": 197,
      "id": "STM-197-FIL-001-model.py",
      "text": "        # e.g. we may load the GPT2 pretrained model checkpoint (block size 1024)",
      "firstCommit": 35,
      "kind": "comment"
    },
    {
      "n": 198,
      "id": "STM-198-FIL-001-model.py",
      "text": "        # but want to use a smaller block size for some smaller, simpler model",
      "firstCommit": 35,
      "kind": "comment"
    },
    {
      "n": 199,
      "id": "STM-199-FIL-001-model.py",
      "text": "        assert block_size <= self.config.block_size",
      "firstCommit": 35,
      "kind": "code"
    },
    {
      "n": 200,
      "id": "STM-200-FIL-001-model.py",
      "text": "        self.config.block_size = block_size",
      "firstCommit": 35,
      "kind": "code"
    },
    {
      "n": 201,
      "id": "STM-201-FIL-001-model.py",
      "text": "        self.transformer.wpe.weight = nn.Parameter(self.transformer.wpe.weight[:block_size])",
      "firstCommit": 35,
      "kind": "code"
    },
    {
      "n": 202,
      "id": "STM-202-FIL-001-model.py",
      "text": "        for block in self.transformer.h:",
      "firstCommit": 36,
      "kind": "code"
    },
    {
      "n": 203,
      "id": "STM-203-FIL-001-model.py",
      "text": "            if hasattr(block.attn, 'bias'):",
      "firstCommit": 36,
      "kind": "code"
    },
    {
      "n": 204,
      "id": "STM-204-FIL-001-model.py",
      "text": "                block.attn.bias = block.attn.bias[:,:,:block_size,:block_size]",
      "firstCommit": 36,
      "kind": "code"
    },
    {
      "n": 205,
      "id": "STM-205-FIL-001-model.py",
      "text": "",
      "firstCommit": 37,
      "kind": "blank"
    },
    {
      "n": 206,
      "id": "STM-206-FIL-001-model.py",
      "text": "    @classmethod",
      "firstCommit": 37,
      "kind": "code"
    },
    {
      "n": 207,
      "id": "STM-207-FIL-001-model.py",
      "text": "    def from_pretrained(cls, model_type, override_args=None):",
      "firstCommit": 37,
      "kind": "code"
    },
    {
      "n": 208,
      "id": "STM-208-FIL-001-model.py",
      "text": "        assert model_type in {'gpt2', 'gpt2-medium', 'gpt2-large', 'gpt2-xl'}",
      "firstCommit": 37,
      "kind": "code"
    },
    {
      "n": 209,
      "id": "STM-209-FIL-001-model.py",
      "text": "        override_args = override_args or {} # default to empty dict",
      "firstCommit": 37,
      "kind": "code"
    },
    {
      "n": 210,
      "id": "STM-210-FIL-001-model.py",
      "text": "        # only dropout can be overridden see more notes below",
      "firstCommit": 37,
      "kind": "comment"
    },
    {
      "n": 211,
      "id": "STM-211-FIL-001-model.py",
      "text": "        assert all(k == 'dropout' for k in override_args)",
      "firstCommit": 37,
      "kind": "code"
    },
    {
      "n": 212,
      "id": "STM-212-FIL-001-model.py",
      "text": "        from transformers import GPT2LMHeadModel",
      "firstCommit": 37,
      "kind": "code"
    },
    {
      "n": 213,
      "id": "STM-213-FIL-001-model.py",
      "text": "        print(\"loading weights from pretrained gpt: %s\" % model_type)",
      "firstCommit": 37,
      "kind": "code"
    },
    {
      "n": 214,
      "id": "STM-214-FIL-001-model.py",
      "text": "",
      "firstCommit": 38,
      "kind": "blank"
    },
    {
      "n": 215,
      "id": "STM-215-FIL-001-model.py",
      "text": "        # n_layer, n_head and n_embd are determined from model_type",
      "firstCommit": 38,
      "kind": "comment"
    },
    {
      "n": 216,
      "id": "STM-216-FIL-001-model.py",
      "text": "        config_args = {",
      "firstCommit": 38,
      "kind": "code"
    },
    {
      "n": 217,
      "id": "STM-217-FIL-001-model.py",
      "text": "            'gpt2':         dict(n_layer=12, n_head=12, n_embd=768),  # 124M params",
      "firstCommit": 38,
      "kind": "code"
    },
    {
      "n": 218,
      "id": "STM-218-FIL-001-model.py",
      "text": "            'gpt2-medium':  dict(n_layer=24, n_head=16, n_embd=1024), # 350M params",
      "firstCommit": 38,
      "kind": "code"
    },
    {
      "n": 219,
      "id": "STM-219-FIL-001-model.py",
      "text": "            'gpt2-large':   dict(n_layer=36, n_head=20, n_embd=1280), # 774M params",
      "firstCommit": 38,
      "kind": "code"
    },
    {
      "n": 220,
      "id": "STM-220-FIL-001-model.py",
      "text": "            'gpt2-xl':      dict(n_layer=48, n_head=25, n_embd=1600), # 1558M params",
      "firstCommit": 38,
      "kind": "code"
    },
    {
      "n": 221,
      "id": "STM-221-FIL-001-model.py",
      "text": "        }[model_type]",
      "firstCommit": 38,
      "kind": "code"
    },
    {
      "n": 222,
      "id": "STM-222-FIL-001-model.py",
      "text": "        print(\"forcing vocab_size=50257, block_size=1024, bias=True\")",
      "firstCommit": 39,
      "kind": "code"
    },
    {
      "n": 223,
      "id": "STM-223-FIL-001-model.py",
      "text": "        config_args['vocab_size'] = 50257 # always 50257 for GPT model checkpoints",
      "firstCommit": 39,
      "kind": "code"
    },
    {
      "n": 224,
      "id": "STM-224-FIL-001-model.py",
      "text": "        config_args['block_size'] = 1024 # always 1024 for GPT model checkpoints",
      "firstCommit": 39,
      "kind": "code"
    },
    {
      "n": 225,
      "id": "STM-225-FIL-001-model.py",
      "text": "        config_args['bias'] = True # always True for GPT model checkpoints",
      "firstCommit": 39,
