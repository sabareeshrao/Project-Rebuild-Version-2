    },
    {
      "n": 120,
      "id": "STM-120-FIL-001-model.py",
      "text": "    def __init__(self, config):",
      "firstCommit": 22,
      "kind": "code"
    },
    {
      "n": 121,
      "id": "STM-121-FIL-001-model.py",
      "text": "        super().__init__()",
      "firstCommit": 22,
      "kind": "code"
    },
    {
      "n": 122,
      "id": "STM-122-FIL-001-model.py",
      "text": "        assert config.vocab_size is not None",
      "firstCommit": 22,
      "kind": "code"
    },
    {
