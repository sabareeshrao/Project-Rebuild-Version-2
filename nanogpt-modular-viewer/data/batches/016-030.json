      "kind": "code"
    },
    {
      "n": 163,
      "id": "STM-163-FIL-001-model.py",
      "text": "        if isinstance(module, nn.Linear):",
      "firstCommit": 29,
      "kind": "code"
    },
    {
      "n": 164,
      "id": "STM-164-FIL-001-model.py",
      "text": "            torch.nn.init.normal_(module.weight, mean=0.0, std=0.02)",
