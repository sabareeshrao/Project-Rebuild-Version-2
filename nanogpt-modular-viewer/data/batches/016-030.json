      "text": "            wte = nn.Embedding(config.vocab_size, config.n_embd),",
      "firstCommit": 23,
      "kind": "code"
    },
    {
      "n": 128,
      "id": "STM-128-FIL-001-model.py",
      "text": "            wpe = nn.Embedding(config.block_size, config.n_embd),",
      "firstCommit": 23,
      "kind": "code"
    },
    {
      "n": 129,
      "id": "STM-129-FIL-001-model.py",
      "text": "            drop = nn.Dropout(config.dropout),",
      "firstCommit": 23,
      "kind": "code"
    },
    {
      "n": 130,
      "id": "STM-130-FIL-001-model.py",
      "text": "            h = nn.ModuleList([Block(config) for _ in range(config.n_layer)]),",
      "firstCommit": 23,
      "kind": "code"
    },
    {
      "n": 131,
      "id": "STM-131-FIL-001-model.py",
      "text": "            ln_f = LayerNorm(config.n_embd, bias=config.bias),",
      "firstCommit": 23,
      "kind": "code"
    },
    {
      "n": 132,
      "id": "STM-132-FIL-001-model.py",
      "text": "        ))",
      "firstCommit": 23,
      "kind": "code"
    },
    {
      "n": 133,
      "id": "STM-133-FIL-001-model.py",
      "text": "        self.lm_head = nn.Linear(config.n_embd, config.vocab_size, bias=False)",
      "firstCommit": 24,
      "kind": "code"
    },
    {
      "n": 134,
      "id": "STM-134-FIL-001-model.py",
      "text": "        # with weight tying when using torch.compile() some warnings get generated:",
      "firstCommit": 24,
      "kind": "comment"
    },
    {
      "n": 135,
      "id": "STM-135-FIL-001-model.py",
      "text": "        # \"UserWarning: functional_call was passed multiple values for tied weights.",
      "firstCommit": 24,
