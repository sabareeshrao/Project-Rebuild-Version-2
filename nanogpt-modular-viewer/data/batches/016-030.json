    },
    {
      "n": 148,
      "id": "STM-148-FIL-001-model.py",
      "text": "        print(\"number of parameters: %.2fM\" % (self.get_num_params()/1e6,))",
      "firstCommit": 26,
      "kind": "code"
    },
    {
      "n": 149,
