    },
    {
      "n": 150,
      "id": "STM-150-FIL-001-model.py",
      "text": "    def get_num_params(self, non_embedding=True):",
      "firstCommit": 27,
      "kind": "code"
    },
    {
      "n": 151,
      "id": "STM-151-FIL-001-model.py",
      "text": "        \"\"\"",
      "firstCommit": 27,
      "kind": "docstring"
    },
    {
      "n": 152,
      "id": "STM-152-FIL-001-model.py",
      "text": "        Return the number of parameters in the model.",
      "firstCommit": 27,
      "kind": "docstring"
    },
    {
      "n": 153,
      "id": "STM-153-FIL-001-model.py",
      "text": "        For non-embedding count (default), the position embeddings get subtracted.",
      "firstCommit": 27,
      "kind": "docstring"
    },
    {
      "n": 154,
      "id": "STM-154-FIL-001-model.py",
      "text": "        The token embeddings would too, except due to the parameter sharing these",
      "firstCommit": 27,
      "kind": "docstring"
    },
    {
      "n": 155,
      "id": "STM-155-FIL-001-model.py",
      "text": "        params are actually used as weights in the final layer, so we include them.",
      "firstCommit": 27,
      "kind": "docstring"
    },
    {
      "n": 156,
      "id": "STM-156-FIL-001-model.py",
      "text": "        \"\"\"",
      "firstCommit": 27,
      "kind": "docstring"
    },
    {
      "n": 157,
      "id": "STM-157-FIL-001-model.py",
      "text": "        n_params = sum(p.numel() for p in self.parameters())",
