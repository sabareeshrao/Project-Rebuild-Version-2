    },
    {
      "n": 138,
      "id": "STM-138-FIL-001-model.py",
      "text": "        self.transformer.wte.weight = self.lm_head.weight # https://paperswithcode.com/method/weight-tying",
      "firstCommit": 24,
      "kind": "code"
    },
    {
      "n": 139,
      "id": "STM-139-FIL-001-model.py",
      "text": "",
      "firstCommit": 25,
      "kind": "blank"
    },
    {
      "n": 140,
      "id": "STM-140-FIL-001-model.py",
      "text": "        # init all weights",
      "firstCommit": 25,
      "kind": "comment"
    },
    {
      "n": 141,
      "id": "STM-141-FIL-001-model.py",
      "text": "        self.apply(self._init_weights)",
      "firstCommit": 25,
      "kind": "code"
    },
    {
      "n": 142,
      "id": "STM-142-FIL-001-model.py",
      "text": "        # apply special scaled init to the residual projections, per GPT-2 paper",
      "firstCommit": 25,
      "kind": "comment"
    },
    {
      "n": 143,
      "id": "STM-143-FIL-001-model.py",
      "text": "        for pn, p in self.named_parameters():",
      "firstCommit": 25,
      "kind": "code"
    },
    {
      "n": 144,
      "id": "STM-144-FIL-001-model.py",
      "text": "            if pn.endswith('c_proj.weight'):",
      "firstCommit": 25,
      "kind": "code"
    },
    {
      "n": 145,
      "id": "STM-145-FIL-001-model.py",
      "text": "                torch.nn.init.normal_(p, mean=0.0, std=0.02/math.sqrt(2 * config.n_layer))",
      "firstCommit": 25,
      "kind": "code"
    },
    {
      "n": 146,
